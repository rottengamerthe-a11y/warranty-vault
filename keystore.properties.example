# Copy this file to `keystore.properties` and fill in real values for local release builds.
# Do NOT commit your real `keystore.properties` to source control.
# Example keys:
STORE_PASSWORD=change_me_store_password
KEY_ALIAS=change_me_key_alias
KEY_PASSWORD=change_me_key_password
# Optional: path to the keystore file relative to the project root.
# If omitted, the build defaults to `warrantyvault-keystore.jks` in the project root.
KEYSTORE_FILE=warrantyvault-keystore.jks

# To build locally with this example, generate a keystore like:
# keytool -genkeypair -v -keystore warrantyvault-keystore.jks -alias change_me_key_alias -keyalg RSA -keysize 2048 -validity 10000

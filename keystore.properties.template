# keystore.properties.template
# Copy this file to `keystore.properties` locally and fill in the secret values.
# DO NOT commit `keystore.properties` or your `.jks` file to source control.

STORE_PASSWORD=your-keystore-password
KEY_ALIAS=warranty_vault
KEY_PASSWORD=your-key-password
KEYSTORE_FILE=./warrantyvault-keystore.jks

# Recommended CI secret names (do NOT commit these values):
# - KEYSTORE_BASE64 : base64 of the .jks keystore file
# - STORE_PASSWORD  : keystore store password
# - KEY_ALIAS       : key alias inside the keystore
# - KEY_PASSWORD    : key password for the alias
